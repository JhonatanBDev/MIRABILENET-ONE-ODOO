      "id": "c1100000-0000-4000-8000-000000000002",
      "name": "Pedir el envío a Django",
      "notesInFlow": true,
      "notes": "Why HTTP: la API de MIRABILENET no tiene nodo propio. Django aplica las reglas (ventana de 24 h, persona atendiendo, baja, tope por hora, idempotencia por clave) y envía por el canal de la conversación.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8069/api/v1/messaging/n8n/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { conversacion_id: $json.conversacion_id, tipo: $json.tipo, contenido: $json.contenido, clave: $json.clave } }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kv5LPHIDptIliTMh",
          "name": "MIRABILENET API"
        }
      }
    },
    {
      "id": "c1100000-0000-4000-8000-000000000003",
      "name": "¿Falló el servidor?",
      "type": "n8n-nodes-base.if",
