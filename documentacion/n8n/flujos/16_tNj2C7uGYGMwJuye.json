        "url": "=http://host.docker.internal:8069/api/v1/messaging/n8n/conversations/{{ $json.conversacion_id }}/handoff",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { motivo: $json.motivo, mensaje_id: $json.mensaje_id, tipo: $json.tipo || 'ayuda' } }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
