<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_mirabilenet_fiscal" model="ir.ui.view">
        <field name="name">res.company.form.mirabilenet.fiscal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MIRABILENET" name="mirabilenet_fiscal">
                    <group><field name="mirabilenet_invoice_on_payment"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
