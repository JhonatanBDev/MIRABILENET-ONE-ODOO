<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Zonas -->
    <record id="view_mirabilenet_zone_list" model="ir.ui.view">
        <field name="name">mirabilenet.zone.list</field>
        <field name="model">mirabilenet.zone</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="region_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="sector"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_zone" model="ir.actions.act_window">
        <field name="name">Zonas</field>
        <field name="res_model">mirabilenet.zone</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
