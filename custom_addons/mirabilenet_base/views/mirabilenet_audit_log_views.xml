<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Auditoría -->
    <record id="view_mirabilenet_audit_log_list" model="ir.ui.view">
        <field name="name">mirabilenet.audit.log.list</field>
        <field name="model">mirabilenet.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Cuándo"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="description"/>
                <field name="region_id"/>
                <field name="payload" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_audit_log" model="ir.actions.act_window">
        <field name="name">Auditoría</field>
        <field name="res_model">mirabilenet.audit.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
