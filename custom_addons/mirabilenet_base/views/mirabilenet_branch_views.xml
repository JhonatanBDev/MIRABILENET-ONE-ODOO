<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sucursales -->
    <record id="view_mirabilenet_branch_list" model="ir.ui.view">
        <field name="name">mirabilenet.branch.list</field>
        <field name="model">mirabilenet.branch</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="region_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_branch" model="ir.actions.act_window">
        <field name="name">Sucursales</field>
        <field name="res_model">mirabilenet.branch</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
