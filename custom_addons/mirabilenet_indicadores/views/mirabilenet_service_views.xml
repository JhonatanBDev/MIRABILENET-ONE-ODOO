<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_pivot" model="ir.ui.view">
        <field name="name">mirabilenet.service.pivot.mirabilenet</field>
        <field name="model">mirabilenet.service</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Servicios por región" sample="1">
                <field name="region_id" type="row"/><field name="state" type="col"/><field name="monthly_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_service_graph" model="ir.ui.view">
        <field name="name">mirabilenet.service.graph.mirabilenet</field>
        <field name="model">mirabilenet.service</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Servicios por región" type="bar" stacked="1" sample="1">
                <field name="region_id"/><field name="state"/><field name="monthly_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_service" model="ir.actions.act_window">
        <field name="name">Servicios y mensualidad por región</field>
        <field name="res_model">mirabilenet.service</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_service_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_service_graph')})]"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">—</p><p>Sin servicios en su región. La suma de la mensualidad de los activos y morosos es el ingreso mensual recurrente (MRR).</p></field>
    </record>
</odoo>
