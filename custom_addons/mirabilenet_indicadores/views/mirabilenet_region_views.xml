<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_region_goal_list" model="ir.ui.view">
        <field name="name">mirabilenet.region.goal.list</field>
        <field name="model">mirabilenet.region</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-danger="mirabilenet_goal_state == 'no_alcanzable'"
                  decoration-success="mirabilenet_goal_state == 'alcanzable'"
                  decoration-muted="mirabilenet_goal_state == 'sin_datos'">
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="objetivo_mrr"/>
                <field name="precio_referencia"/>
                <field name="mirabilenet_mrr"/>
                <field name="mirabilenet_capacity"/>
                <field name="mirabilenet_ceiling"/>
                <field name="mirabilenet_customers_needed"/>
                <field name="mirabilenet_goal_state" widget="badge"/>
                <field name="mirabilenet_goal_message"/>
            </list>
        </field>
    </record>

    <record id="action_region_goal" model="ir.actions.act_window">
        <field name="name">Objetivo de MRR por región</field>
        <field name="res_model">mirabilenet.region</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_region_goal_list"/>
    </record>
</odoo>
