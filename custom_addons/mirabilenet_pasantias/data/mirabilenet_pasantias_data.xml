<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_todo" model="project.task.type">
            <field name="name">Por hacer</field><field name="user_id" eval="False"/><field name="sequence">1</field>
        </record>
        <record id="stage_doing" model="project.task.type">
            <field name="name">En curso</field><field name="user_id" eval="False"/><field name="sequence">2</field>
        </record>
        <record id="stage_delivered" model="project.task.type">
            <field name="name">Entregada, en revisión</field><field name="user_id" eval="False"/><field name="sequence">3</field>
            <field name="mirabilenet_shared" eval="True"/>
        </record>
        <record id="stage_approved" model="project.task.type">
            <field name="name">Aprobada</field><field name="user_id" eval="False"/><field name="sequence">4</field>
            <field name="mirabilenet_shared" eval="True"/>
            <field name="fold" eval="True"/>
        </record>
    </data>
</odoo>
