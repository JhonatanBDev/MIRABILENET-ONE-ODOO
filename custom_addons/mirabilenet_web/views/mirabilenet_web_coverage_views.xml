<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_coverage_list" model="ir.ui.view">
        <field name="name">mirabilenet.web.coverage.list</field>
        <field name="model">mirabilenet.web.coverage</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="sequence" widget="handle"/><field name="region_id"/><field name="name"/><field name="detail"/><field name="state"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>

    <record id="action_web_coverage" model="ir.actions.act_window">
        <field name="name">Cobertura</field>
        <field name="res_model">mirabilenet.web.coverage</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
