<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_advantage_list" model="ir.ui.view">
        <field name="name">mirabilenet.web.advantage.list</field>
        <field name="model">mirabilenet.web.advantage</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="sequence" widget="handle"/><field name="icon"/><field name="title"/><field name="detail"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>

    <record id="action_web_advantage" model="ir.actions.act_window">
        <field name="name">Ventajas</field>
        <field name="res_model">mirabilenet.web.advantage</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
