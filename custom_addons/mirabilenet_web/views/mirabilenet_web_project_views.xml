<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_project_list" model="ir.ui.view">
        <field name="name">mirabilenet.web.project.list</field>
        <field name="model">mirabilenet.web.project</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="title"/><field name="kind"/><field name="location"/><field name="date"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>

    <record id="view_web_project_form" model="ir.ui.view">
        <field name="name">mirabilenet.web.project.form</field>
        <field name="model">mirabilenet.web.project</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group><group><field name="title"/><field name="slug"/><field name="kind"/>
                <field name="location"/><field name="date"/></group>
                <group><field name="image" widget="image" options="{'size': [240, 160]}"/>
                <field name="sequence"/><field name="active"/></group></group>
                <group><field name="summary"/><field name="description"/></group>
            </sheet></form>
        </field>
    </record>

    <record id="action_web_project" model="ir.actions.act_window">
        <field name="name">Proyectos</field>
        <field name="res_model">mirabilenet.web.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
