            </t>
            <t t-snippet="mirabilenet_web.s_mn_projects" string="Proyectos" group="mirabilenet">
                <keywords>mirabilenet, proyectos</keywords>
            </t>
            <t t-snippet="mirabilenet_web.s_mn_faq" string="Preguntas frecuentes" group="mirabilenet">
                <keywords>mirabilenet, preguntas frecuentes</keywords>
            </t>
            <t t-snippet="mirabilenet_web.s_mn_advantages" string="Ventajas" group="mirabilenet">
