    <template id="snippets" inherit_id="website.snippets" name="MIRABILENET: bloques">
        <xpath expr="//t[@id='installed_snippets_hook']" position="before">
            <t snippet-group="mirabilenet" t-snippet="website.s_snippet_group" string="MIRABILENET"
               t-thumbnail="/mirabilenet_web/static/description/icon.png"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="mirabilenet_web.s_mn_services" string="Servicios" group="mirabilenet">
                <keywords>mirabilenet, servicios</keywords>
            </t>
            <t t-snippet="mirabilenet_web.s_mn_plans" string="Planes de internet" group="mirabilenet">
                <keywords>mirabilenet, planes de internet</keywords>
            </t>
            <t t-snippet="mirabilenet_web.s_mn_coverage" string="Cobertura" group="mirabilenet">
