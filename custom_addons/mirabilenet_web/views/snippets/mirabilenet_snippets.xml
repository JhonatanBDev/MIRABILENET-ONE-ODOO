                <div>
                    <strong t-out="data.get('title')"/>
                    <div t-if="data.get('detail')" class="text-muted" t-out="data['detail']"/>
                </div>
            </div>
        </t>
    </template>
    <template id="dynamic_filter_template_mirabilenet_web_figure_list" name="MIRABILENET: Cifras">
