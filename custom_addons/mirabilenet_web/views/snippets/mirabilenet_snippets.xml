    <template id="dynamic_filter_template_mirabilenet_web_service_cards" name="MIRABILENET: Servicios">
        <t t-foreach="records" t-as="data" data-column-classes="col-12 col-md-6 col-lg-3" data-extra-classes="g-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <i t-attf-class="fa fa-2x text-primary mb-3 fa-#{data.get('mn_icon', 'circle')}"/>
                    <h3 class="h5" t-out="data.get('name')"/>
                    <p class="text-muted" t-out="data.get('summary')"/>
                    <a t-if="data.get('mn_url')" t-att-href="data['mn_url']">Ver detalle <i class="fa fa-long-arrow-right"/></a>
                </div>
            </div>
        </t>
    </template>
    <template id="dynamic_filter_template_product_template_mn_plans" name="MIRABILENET: Planes de internet">
        <t t-foreach="records" t-as="data" data-column-classes="col-12 col-md-6 col-lg-4" data-extra-classes="g-4">
            <div t-attf-class="mn_plan #{'mn_plan_featured' if data_index == 1 else ''}">
                <div class="mn_plan_tag"><t t-if="data_index == 1">Más contratado</t></div>
                <h3 class="mn_plan_name" t-out="data.get('name')"/>
                <div class="mn_plan_region" t-out="data.get('mn_region') or 'Todas las regiones'"/>
                <div t-if="data.get('mn_down')" class="mn_plan_speed">
                    <span class="mn_plan_number" t-out="data['mn_down']"/>
                    <span class="mn_plan_unit">Mbps</span>
                </div>
                <div t-if="data.get('mn_down')" class="mn_plan_caption">de bajada</div>
                <ul class="mn_plan_features">
                    <li t-if="data.get('mn_up')"><span>Subida</span><span><t t-out="data['mn_up']"/> Mbps</span></li>
                    <li t-if="data.get('mn_tv')"><span>Televisión</span><span>Incluida</span></li>
                    <li><span>Instalación</span><span>Se cotiza aparte</span></li>
                </ul>
                <div class="mn_plan_foot">
                    <div class="mn_plan_price">
                        <t t-if="data.get('mn_price')">Desde<strong>Bs <t t-out="data['mn_price']"/>/mes</strong></t>
                        <t t-else="">Precio<strong>A cotizar</strong></t>
                    </div>
                    <a t-att-href="data.get('mn_url', '/contacto?tipo=cotizacion')" class="btn btn-primary">Lo quiero</a>
                </div>
            </div>
        </t>
    </template>
    <template id="dynamic_filter_template_mirabilenet_web_coverage_cards" name="MIRABILENET: Cobertura">
        <t t-foreach="records" t-as="data" data-column-classes="col-6 col-md-4 col-lg-3" data-extra-classes="g-3">
            <div class="card h-100">
                <div class="card-body">
                    <strong t-out="data.get('name')"/>
                    <span t-if="data.get('mn_state')" t-attf-class="badge ms-2 #{data.get('mn_badge', 'text-bg-secondary')}" t-out="data['mn_state']"/>
                    <div t-if="data.get('mn_region')" class="small text-primary mt-1" t-out="data['mn_region']"/>
                    <div t-if="data.get('detail')" class="text-muted small mt-1" t-out="data['detail']"/>
                </div>
            </div>
        </t>
    </template>
    <template id="dynamic_filter_template_mirabilenet_web_project_cards" name="MIRABILENET: Proyectos">
        <t t-foreach="records" t-as="data" data-column-classes="col-12 col-md-6 col-lg-4" data-extra-classes="g-4">
            <div class="card h-100 shadow-sm">
                <img t-if="data.get('mn_image')" class="card-img-top" t-att-src="data['mn_image']" t-att-alt="data.get('title')"/>
                <div class="card-body">
                    <small t-if="data.get('mn_kind')" class="text-uppercase text-primary" t-out="data['mn_kind']"/>
                    <h3 class="h5 mt-1">
                        <a t-if="data.get('mn_url')" t-att-href="data['mn_url']" t-out="data.get('title')"/>
                        <t t-else="" t-out="data.get('title')"/>
                    </h3>
                    <p class="text-muted" t-out="data.get('summary')"/>
                    <small t-if="data.get('mn_place')" class="text-muted" t-out="data['mn_place']"/>
                </div>
            </div>
        </t>
    </template>
    <template id="dynamic_filter_template_mirabilenet_web_faq_list" name="MIRABILENET: Preguntas frecuentes">
        <t t-foreach="records" t-as="data" data-column-classes="col-12" data-extra-classes="g-2">
            <details class="border rounded p-3 w-100">
                <summary class="fw-bold" t-out="data.get('question')"/>
                <small t-if="data.get('mn_category')" class="text-primary" t-out="data['mn_category']"/>
                <p t-foreach="data.get('mn_answer', [])" t-as="parrafo" class="mt-2 mb-0" t-out="parrafo"/>
            </details>
        </t>
    </template>
    <template id="dynamic_filter_template_mirabilenet_web_advantage_list" name="MIRABILENET: Ventajas">
        <t t-foreach="records" t-as="data" data-column-classes="col-12 col-md-4" data-extra-classes="g-4">
