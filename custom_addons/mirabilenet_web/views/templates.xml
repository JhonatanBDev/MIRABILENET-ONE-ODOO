                    <t t-set="bajada" t-value="documento.summary"/>
                </t>
                <div class="oe_structure oe_empty" id="oe_structure_mn_legal_1"/>
                <section class="pt48 pb48">
                    <div class="container" style="max-width: 820px">
                        <t t-foreach="documento._sections()" t-as="s">
                            <h2 t-if="s['titulo']" class="h4 mt-4" t-out="s['titulo']"/>
                            <p t-foreach="s['parrafos']" t-as="parrafo" t-out="parrafo"/>
                            <ul t-if="s['vinetas']"><li t-foreach="s['vinetas']" t-as="v" t-out="v"/></ul>
                        </t>
                        <t t-foreach="[('Cookies de este sitio', cookies_sitio), ('Cookies del sistema de gestión', cookies_panel)]" t-as="tabla">
                            <t t-if="tabla[1]">
                                <h2 class="h4 mt-4" t-out="tabla[0]"/>
                                <table class="table table-sm">
                                    <thead><tr><th>Cookie</th><th>Titular</th><th>Finalidad</th><th>Categoría</th><th>Duración</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="tabla[1]" t-as="c">
                                            <td><code t-out="c['nombre']"/></td><td t-out="c['titular']"/>
                                            <td t-out="c['finalidad']"/><td t-out="c['categoria']"/>
                                            <td t-out="c['duracion']"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                        <p class="text-muted small mt-5">
                            Versión <t t-out="documento.version"/>, vigente desde el
                            <span t-field="documento.valid_from" t-options="{'format': 'd \'de\' MMMM \'de\' y'}"/>.
                        </p>
                    </div>
                </section>
                <div class="oe_structure oe_empty" id="oe_structure_mn_legal_2"/>
            </div>
        </t>
    </template>
