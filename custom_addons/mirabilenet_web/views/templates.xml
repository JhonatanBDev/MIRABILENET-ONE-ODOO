<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Piezas compartidas -->
    <template id="page_header" name="MIRABILENET: encabezado de página">
        <section class="pt48 pb32 bg-100">
            <div class="container text-center">
                <small class="text-uppercase text-primary fw-bold" t-out="sobretitulo"/>
                <h1 class="mt-2" t-out="titulo"/>
                <p t-if="bajada" class="lead text-muted" t-out="bajada"/>
            </div>
        </section>
    </template>

    <template id="contact_form" name="MIRABILENET: formulario de consulta">
        <form class="mn_contact_form" method="post" action="/contacto">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="origen" t-att-value="form['origin']"/>
            <input type="hidden" name="tipo" t-att-value="form['values']['tipo']"/>
            <input type="hidden" name="plan_interes" t-att-value="form['values']['plan_interes']"/>
            <input type="hidden" name="ts" t-att-value="form['values']['ts']"/>
            <!-- Campo trampa: oculto para las personas -->
            <div style="position:absolute;left:-9999px" aria-hidden="true">
                <label for="mn_website">No completar</label>
                <input type="text" name="website" id="mn_website" tabindex="-1" autocomplete="off"/>
            </div>
            <t t-set="errors" t-value="form['errors']"/>
            <t t-set="values" t-value="form['values']"/>
            <div t-if="errors.get('general')" class="alert alert-danger" t-out="' '.join(errors['general'])"/>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="mn_nombre">Nombre completo</label>
                    <input type="text" name="nombre" id="mn_nombre" maxlength="120" required="required"
                           t-attf-class="form-control #{'is-invalid' if errors.get('nombre') else ''}"
                           t-att-value="values['nombre']"/>
                    <div t-if="errors.get('nombre')" class="invalid-feedback d-block" t-out="' '.join(errors['nombre'])"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="mn_telefono">Teléfono o WhatsApp</label>
                    <input type="text" name="telefono" id="mn_telefono" maxlength="40" required="required"
                           t-attf-class="form-control #{'is-invalid' if errors.get('telefono') else ''}"
                           t-att-value="values['telefono']"/>
                    <div t-if="errors.get('telefono')" class="invalid-feedback d-block" t-out="' '.join(errors['telefono'])"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="mn_email">Correo (opcional)</label>
                    <input type="email" name="email" id="mn_email" maxlength="254" class="form-control"
                           t-att-value="values['email']"/>
                    <div t-if="errors.get('email')" class="invalid-feedback d-block" t-out="' '.join(errors['email'])"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="mn_localidad">Localidad o dirección aproximada</label>
                    <input type="text" name="localidad" id="mn_localidad" maxlength="120" class="form-control"
                           t-att-value="values['localidad']"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="mn_region">Zona</label>
                    <select name="region" id="mn_region" class="form-select">
                        <option value="">No estoy seguro</option>
                        <option t-foreach="form['regions']" t-as="region" t-att-value="region.id"
                                t-att-selected="str(region.id) == values['region'] and 'selected'"
                                t-out="region.name"/>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="mn_servicio">Servicio de interés</label>
                    <select name="servicio" id="mn_servicio" class="form-select">
                        <option value="">Aún no lo sé</option>
                        <option t-foreach="form['services']" t-as="service" t-att-value="service.id"
                                t-att-selected="str(service.id) == values['servicio'] and 'selected'"
                                t-out="service.name"/>
                    </select>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label" for="mn_mensaje">Cuéntenos qué necesita</label>
                    <textarea name="mensaje" id="mn_mensaje" rows="4" maxlength="2000" class="form-control"
                              t-out="values['mensaje']"/>
                    <div t-if="errors.get('mensaje')" class="invalid-feedback d-block" t-out="' '.join(errors['mensaje'])"/>
                </div>
                <div class="col-12 mb-3 form-check ms-2">
                    <input type="checkbox" name="acepta" id="mn_acepta" class="form-check-input" required="required"
                           t-att-checked="values['acepta'] and 'checked'"/>
                    <label class="form-check-label" for="mn_acepta">
                        Autorizo que MIRABILENET use estos datos para responder mi consulta. Puede revisar el
                        <a href="/privacidad">aviso de privacidad</a>.
                    </label>
                    <div t-if="errors.get('acepta')" class="invalid-feedback d-block" t-out="' '.join(errors['acepta'])"/>
                    <div t-if="errors.get('ts')" class="invalid-feedback d-block" t-out="' '.join(errors['ts'])"/>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Enviar consulta</button>
            <p class="text-muted small mt-2 mb-0">Respondemos en horario de atención. Sus datos solo se usan para contactarle.</p>
        </form>
    </template>

    <template id="service_cards" name="MIRABILENET: tarjetas de servicios">
        <div class="row">
            <div t-foreach="servicios" t-as="s" class="col-md-6 col-lg-3 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <i t-attf-class="fa fa-2x text-primary mb-3 fa-#{s._fa_icon()}"/>
                        <h3 class="h5" t-out="s.name"/>
                        <p class="text-muted" t-out="s.summary"/>
                        <a t-attf-href="/servicios/#{s.slug}">Ver detalle <i class="fa fa-long-arrow-right"/></a>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="plan_cards" name="MIRABILENET: tarjetas de planes">
        <div class="row justify-content-center g-4">
            <div t-foreach="planes" t-as="p" class="col-md-6 col-lg-4">
                <div t-attf-class="mn_plan #{'mn_plan_featured' if p_index == 1 else ''}">
                    <div class="mn_plan_tag"><t t-if="p_index == 1">Más contratado</t></div>
                    <h3 class="mn_plan_name" t-out="p.name"/>
                    <div class="mn_plan_region" t-out="p.mirabilenet_region_id.name or 'Todas las regiones'"/>
                    <div class="mn_plan_speed">
                        <span class="mn_plan_number" t-out="p.mirabilenet_down_mbps"/>
                        <span class="mn_plan_unit">Mbps</span>
                    </div>
                    <div class="mn_plan_caption">de bajada</div>
                    <ul class="mn_plan_features">
                        <li><span>Subida</span><span><t t-out="p.mirabilenet_up_mbps"/> Mbps</span></li>
                        <li t-if="p.mirabilenet_includes_tv"><span>Televisión</span><span>Incluida</span></li>
                        <li><span>Instalación</span><span>Se cotiza aparte</span></li>
                    </ul>
                    <div class="mn_plan_foot">
                        <div class="mn_plan_price">
                            <t t-if="sitio.show_prices">Desde<strong>Bs <t t-out="'%.0f' % p.list_price"/>/mes</strong></t>
                            <t t-else="">Precio<strong>A cotizar</strong></t>
                        </div>
                        <a t-attf-href="/contacto?tipo=cotizacion&amp;plan=#{p.mirabilenet_plan_code}"
                           class="btn btn-primary">Lo quiero</a>
                    </div>
                </div>
            </div>
        </div>
    </template>

