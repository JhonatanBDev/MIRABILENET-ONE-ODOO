<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_legal_list" model="ir.ui.view">
        <field name="name">mirabilenet.web.legal.list</field>
        <field name="model">mirabilenet.web.legal</field>
        <field name="arch" type="xml">
            <list><field name="kind"/><field name="title"/><field name="version"/><field name="valid_from"/></list>
        </field>
    </record>

    <record id="view_web_legal_form" model="ir.ui.view">
        <field name="name">mirabilenet.web.legal.form</field>
        <field name="model">mirabilenet.web.legal</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group><group><field name="kind"/><field name="title"/></group>
                <group><field name="version"/><field name="valid_from"/></group></group>
                <group><field name="summary"/><field name="content"/></group>
            </sheet></form>
        </field>
    </record>

    <record id="action_web_legal" model="ir.actions.act_window">
        <field name="name">Textos legales</field>
        <field name="res_model">mirabilenet.web.legal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
