<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_faq_list" model="ir.ui.view">
        <field name="name">mirabilenet.web.faq.list</field>
        <field name="model">mirabilenet.web.faq</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="sequence" widget="handle"/><field name="category"/><field name="question"/><field name="answer"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>

    <record id="action_web_faq" model="ir.actions.act_window">
        <field name="name">Preguntas frecuentes</field>
        <field name="res_model">mirabilenet.web.faq</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
