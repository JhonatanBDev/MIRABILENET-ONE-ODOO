<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_mirabilenet_web_publisher" model="res.groups">
            <field name="name">MIRABILENET / Publica en el sitio web</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>

        <record id="mirabilenet_base.group_role_superadmin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_web_publisher'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_gerencia" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_web_publisher'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_admin_regional" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_web_publisher'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Localidades: cada región publica las suyas. -->
        <record id="rule_web_coverage_region" model="ir.rule">
            <field name="name">MIRABILENET: cobertura de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_web_coverage"/>
            <field name="domain_force">[('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_web_coverage_global" model="ir.rule">
            <field name="name">MIRABILENET: cobertura, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_web_coverage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <!-- Consultas: las de la región del usuario y las que aún no tienen región. -->
        <record id="rule_lead_region" model="ir.rule">
            <field name="name">MIRABILENET: consultas de la región del usuario</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_lead_global" model="ir.rule">
            <field name="name">MIRABILENET: consultas, alcance global</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
    </data>
</odoo>
