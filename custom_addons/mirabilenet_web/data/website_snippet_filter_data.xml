<odoo>
    <!-- Fuentes de los bloques dinámicos: leen con privilegios solo lo publicado. -->
    <record id="mn_action_servicios" model="ir.actions.server">
        <field name="name">MIRABILENET: Servicios (sitio web)</field>
        <field name="model_id" ref="model_mirabilenet_web_service"/>
        <field name="state">code</field>
        <field name="code">response = model.env['website.snippet.filter']._mirabilenet_records('servicios')</field>
    </record>
