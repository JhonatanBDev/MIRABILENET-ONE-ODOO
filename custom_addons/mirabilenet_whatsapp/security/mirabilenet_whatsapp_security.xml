        <record id="group_mirabilenet_whatsapp_config" model="res.groups">
            <field name="name">MIRABILENET / Configura WhatsApp (números, plantillas, QR)</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="group_mirabilenet_whatsapp_operator" model="res.groups">
