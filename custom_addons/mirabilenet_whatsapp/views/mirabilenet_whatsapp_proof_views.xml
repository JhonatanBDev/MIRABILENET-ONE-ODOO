<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Comprobantes -->
    <record id="view_mirabilenet_proof_list" model="ir.ui.view">
        <field name="name">mirabilenet.whatsapp.proof.list</field>
        <field name="model">mirabilenet.whatsapp.proof</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="simulated">
                <field name="create_date" string="Recibido"/>
                <field name="partner_id"/>
                <field name="region_id"/>
                <field name="charge_id"/>
                <field name="mime_type"/>
                <field name="simulated"/>
                <field name="payment_id" optional="show"/>
                <field name="customer_notified" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'revision'"
                       decoration-success="state == 'verificado'"
                       decoration-danger="state == 'rechazado'"/>
            </list>
        </field>
    </record>

    <record id="view_mirabilenet_proof_search" model="ir.ui.view">
        <field name="name">mirabilenet.whatsapp.proof.search</field>
        <field name="model">mirabilenet.whatsapp.proof</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" string="Cliente, código o aviso"
                       filter_domain="['|', '|', ('partner_id.name', 'ilike', self), ('partner_id.mirabilenet_code', 'ilike', self), ('charge_id.number', 'ilike', self)]"/>
                <filter name="revision" string="En verificación"
                        domain="[('state', '=', 'revision')]"/>
                <filter name="verificados" string="Verificados"
                        domain="[('state', '=', 'verificado')]"/>
                <filter name="rechazados" string="Rechazados"
                        domain="[('state', '=', 'rechazado')]"/>
                <separator/>
                <filter name="imagenes" string="Imágenes"
                        domain="[('mime_type', 'like', 'image/')]"/>
                <filter name="pdf" string="PDF" domain="[('mime_type', '=', 'application/pdf')]"/>
            </search>
        </field>
    </record>

    <record id="view_mirabilenet_proof_form" model="ir.ui.view">
        <field name="name">mirabilenet.whatsapp.proof.form</field>
        <field name="model">mirabilenet.whatsapp.proof</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_verify" type="object" string="Verificar y registrar pago"
                            class="btn-primary" invisible="state != 'revision' or simulated"
                            confirm="Se registrará el pago de la factura a su nombre y, si está habilitado, se emitirá la factura fiscal."
                            groups="account.group_account_invoice"/>
                    <button name="%(action_whatsapp_proof_reject_wizard)d"
                            type="action" string="Rechazar"
                            context="{'default_proof_id': id}"
                            invisible="state != 'revision'"
                            groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not simulated">
                        Prueba del simulador: no se puede verificar. Rechácelo para cerrarlo.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'revision' or simulated">
                        Recibir un comprobante no registra un pago ni reactiva el servicio:
                        eso ocurre al verificarlo.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="region_id"/>
                            <field name="charge_id" readonly="state != 'revision'"
                                   options="{'no_create': True}"/>
                            <field name="payment_id" invisible="not payment_id"/>
                            <field name="reject_reason" invisible="not reject_reason"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="mime_type"/>
                            <field name="simulated"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_at"/>
                            <field name="customer_notified"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_proof" model="ir.actions.act_window">
        <field name="name">Comprobantes</field>
        <field name="res_model">mirabilenet.whatsapp.proof</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_revision': 1}</field>
    </record>
</odoo>
