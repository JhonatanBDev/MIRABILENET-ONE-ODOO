<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solicitudes -->
    <record id="view_mirabilenet_case_list" model="ir.ui.view">
        <field name="name">mirabilenet.support.case.list</field>
        <field name="model">mirabilenet.support.case</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-bf="state == 'nuevo'">
                <field name="create_date" string="Recibida"/>
                <field name="partner_id"/>
                <field name="region_id"/>
                <field name="kind"/>
                <field name="reason"/>
                <field name="assigned_to"/>
                <field name="state" widget="badge" decoration-warning="state == 'nuevo'"
                       decoration-info="state == 'atencion'"
                       decoration-success="state == 'resuelto'"/>
                <button name="action_take" type="object" string="Tomar"
                        invisible="state != 'nuevo'"/>
                <button name="action_resolve" type="object" string="Resolver"
                        invisible="state == 'resuelto'"/>
            </list>
        </field>
    </record>

    <record id="view_mirabilenet_case_search" model="ir.ui.view">
        <field name="name">mirabilenet.support.case.search</field>
        <field name="model">mirabilenet.support.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="abiertas" string="Sin resolver"
                        domain="[('state', '!=', 'resuelto')]"/>
                <filter name="bajas" string="Bajas del servicio"
                        domain="[('kind', '=', 'baja_servicio')]"/>
                <filter name="mias" string="Mías" domain="[('assigned_to', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_mirabilenet_case" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">mirabilenet.support.case</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_abiertas': 1}</field>
    </record>
</odoo>
