<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alertas de n8n -->
    <record id="view_mirabilenet_alert_list" model="ir.ui.view">
        <field name="name">mirabilenet.integration.alert.list</field>
        <field name="model">mirabilenet.integration.alert</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'nueva'">
                <field name="last_at"/>
                <field name="workflow"/>
                <field name="node"/>
                <field name="message"/>
                <field name="repetitions"/>
                <field name="execution_id" optional="hide"/>
                <field name="state"/>
                <button name="action_resolve" type="object" string="Resuelta"
                        invisible="state == 'resuelta'"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_alert" model="ir.actions.act_window">
        <field name="name">Alertas de n8n</field>
        <field name="res_model">mirabilenet.integration.alert</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'nueva')]</field>
    </record>
</odoo>
