<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Números -->
    <record id="view_mirabilenet_whatsapp_number_list" model="ir.ui.view">
        <field name="name">mirabilenet.whatsapp.number.list</field>
        <field name="model">mirabilenet.whatsapp.number</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="branch_id" options="{'no_create': True}"/>
                <field name="region_id"/>
                <field name="display_number"/>
                <field name="phone_number_id"/>
                <field name="sender_name"/>
                <field name="mode"/>
                <field name="shared_global"/>
                <field name="active"/>
                <field name="verified_at"/>
                <field name="meta_platform" optional="show"/>
                <field name="last_error" optional="show"/>
                <button name="action_verify" type="object" string="Verificar" icon="fa-check"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_whatsapp_number" model="ir.actions.act_window">
        <field name="name">Números de WhatsApp</field>
        <field name="res_model">mirabilenet.whatsapp.number</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
