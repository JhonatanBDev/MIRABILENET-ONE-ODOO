<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subredes -->
    <record id="view_mirabilenet_subnet_list" model="ir.ui.view">
        <field name="name">mirabilenet.subnet.list</field>
        <field name="model">mirabilenet.subnet</field>
        <field name="arch" type="xml">
            <list>
                <field name="cidr"/>
                <field name="region_id"/>
                <field name="site_id"/>
                <field name="kind"/>
                <field name="gateway"/>
                <field name="partner_id"/>
                <field name="description"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'activa'"
                       decoration-muted="state == 'cuarentena'"/>
            </list>
        </field>
    </record>

    <record id="view_mirabilenet_subnet_form" model="ir.ui.view">
        <field name="name">mirabilenet.subnet.form</field>
        <field name="model">mirabilenet.subnet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Marcar activa"
                            class="btn-primary" invisible="state != 'reservada'"
                            groups="mirabilenet_isp.group_mirabilenet_network_manager"/>
                    <button name="action_release" type="object" string="Liberar"
                            invisible="state == 'cuarentena'"
                            confirm="La subred pasará a cuarentena y no se reutilizará durante 30 días."
                            groups="mirabilenet_isp.group_mirabilenet_network_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="cidr" placeholder="Se asigna al guardar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="region_id" readonly="id" options="{'no_create': True}"/>
                            <field name="kind" readonly="id"/>
                            <field name="site_id"/>
                            <field name="gateway"/>
                        </group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="description"/>
                            <field name="legacy_network"/>
                            <field name="released_at" invisible="not released_at"/>
                        </group>
                    </group>
                    <group string="Reglas netmap" invisible="not netmap_rules">
                        <field name="netmap_rules" nolabel="1" colspan="2"
                               class="font-monospace"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_subnet" model="ir.actions.act_window">
        <field name="name">Subredes</field>
        <field name="res_model">mirabilenet.subnet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
