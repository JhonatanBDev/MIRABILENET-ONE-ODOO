<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mirabilenet_plan_list" model="ir.ui.view">
        <field name="name">product.template.mirabilenet.plan.list</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="mirabilenet_plan_code"/>
                <field name="name"/>
                <field name="mirabilenet_down_mbps"/>
                <field name="mirabilenet_up_mbps"/>
                <field name="list_price" string="Precio mensual"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="mirabilenet_region_id"/>
                <field name="mirabilenet_includes_tv" optional="show"/>
                <field name="active"/>
                <field name="mirabilenet_publish_web"/>
                <field name="mirabilenet_published"/>
            </list>
        </field>
    </record>

    <record id="view_mirabilenet_plan_form" model="ir.ui.view">
        <field name="name">product.template.mirabilenet.plan.form</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Inactivo" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="mirabilenet_is_plan" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Nombre del plan"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
                            <field name="mirabilenet_plan_code" required="1"/>
                            <field name="mirabilenet_region_id" options="{'no_create': True}"
                                   placeholder="Todas las regiones"/>
                            <field name="list_price" string="Precio mensual" widget="monetary"/>
                            <field name="mirabilenet_includes_tv"/>
                        </group>
                        <group string="Velocidad">
                            <field name="mirabilenet_down_mbps"/>
                            <field name="mirabilenet_up_mbps"/>
                            <field name="mirabilenet_ppp_profile"/>
                            <field name="mirabilenet_reduced_profile"/>
                        </group>
                        <group string="Disponibilidad">
                            <field name="active" string="Activo (se puede contratar)"/>
                            <field name="mirabilenet_publish_web"/>
                            <field name="mirabilenet_published"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_plan" model="ir.actions.act_window">
        <field name="name">Planes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('mirabilenet_is_plan', '=', True)]</field>
        <field name="context">{'default_mirabilenet_is_plan': True, 'default_type': 'service', 'active_test': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mirabilenet_plan_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mirabilenet_plan_form')})]"/>
    </record>
</odoo>
