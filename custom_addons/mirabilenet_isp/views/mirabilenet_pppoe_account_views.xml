<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cuentas PPPoE -->
    <record id="view_mirabilenet_pppoe_list" model="ir.ui.view">
        <field name="name">mirabilenet.pppoe.account.list</field>
        <field name="model">mirabilenet.pppoe.account</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="username"/>
                <field name="service_id"/>
                <field name="region_id"/>
                <field name="fixed_ip"/>
                <field name="profile"/>
                <field name="enabled"/>
                <field name="session_active"/>
                <field name="synced"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_pppoe" model="ir.actions.act_window">
        <field name="name">Cuentas PPPoE</field>
        <field name="res_model">mirabilenet.pppoe.account</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
