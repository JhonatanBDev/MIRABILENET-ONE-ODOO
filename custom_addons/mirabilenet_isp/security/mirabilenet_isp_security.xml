<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_mirabilenet_customer_manager" model="res.groups">
            <field name="name">MIRABILENET / Crea y modifica clientes</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user')),
                                             (4, ref('base.group_partner_manager'))]"/>
        </record>
        <record id="group_mirabilenet_plan_manager" model="res.groups">
            <field name="name">MIRABILENET / Crea y modifica planes</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user')),
                                             (4, ref('product.group_product_manager'))]"/>
        </record>

        <!-- Qué rol recibe cada capacidad. -->
        <record id="mirabilenet_base.group_role_superadmin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_customer_manager')),
                                             (4, ref('group_mirabilenet_plan_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_gerencia" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_customer_manager')),
                                             (4, ref('group_mirabilenet_plan_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_admin_regional" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_customer_manager')),
                                             (4, ref('group_mirabilenet_plan_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_vendedor" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_customer_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_finanzas" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_customer_manager'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Clientes y sus contactos. Quien solo es usuario interno (el pasante) no ve
             ninguno; el personal ve los de su región; los roles globales, todos. -->
        <record id="rule_partner_not_customer" model="ir.rule">
            <field name="name">MIRABILENET: sin acceso a clientes</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('mirabilenet_restricted', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_partner_region" model="ir.rule">
            <field name="name">MIRABILENET: clientes de la región del usuario</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', ('mirabilenet_restricted', '=', False), ('mirabilenet_scope_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_partner_global" model="ir.rule">
            <field name="name">MIRABILENET: clientes, alcance global</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>

        <!-- Planes: los de la región del usuario y los que valen en todas. -->
        <record id="rule_plan_region" model="ir.rule">
            <field name="name">MIRABILENET: planes de la región del usuario</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">['|', ('mirabilenet_is_plan', '=', False), '|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_plan_global" model="ir.rule">
            <field name="name">MIRABILENET: planes, alcance global</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_plan_variant_region" model="ir.rule">
            <field name="name">MIRABILENET: variantes de planes de la región del usuario</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">['|', ('product_tmpl_id.mirabilenet_is_plan', '=', False), '|', ('product_tmpl_id.mirabilenet_region_id', '=', False), ('product_tmpl_id.mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_plan_variant_global" model="ir.rule">
            <field name="name">MIRABILENET: variantes de planes, alcance global</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
    </data>

    <data noupdate="0">
        <record id="group_mirabilenet_network_manager" model="res.groups">
            <field name="name">MIRABILENET / Administra routers y subredes</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="group_mirabilenet_service_manager" model="res.groups">
            <field name="name">MIRABILENET / Administra servicios y cuentas PPPoE</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user')), (4, ref('base.group_partner_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_superadmin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_network_manager')), (4, ref('group_mirabilenet_service_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_admin_regional" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_network_manager')), (4, ref('group_mirabilenet_service_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_noc" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_network_manager')), (4, ref('group_mirabilenet_service_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_tecnico" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_service_manager'))]"/>
        </record>
    </data>

    <!-- Aislamiento por región de todo lo que es red. -->
    <data noupdate="1">
        <record id="rule_mirabilenet_subnet_region" model="ir.rule">
            <field name="name">MIRABILENET: subredes de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_subnet"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_subnet_global" model="ir.rule">
            <field name="name">MIRABILENET: subredes, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_subnet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_router_region" model="ir.rule">
            <field name="name">MIRABILENET: routers de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_router"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_router_global" model="ir.rule">
            <field name="name">MIRABILENET: routers, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_router"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_enrollment_token_region" model="ir.rule">
            <field name="name">MIRABILENET: códigos de enrolamiento de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_enrollment_token"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_enrollment_token_global" model="ir.rule">
            <field name="name">MIRABILENET: códigos de enrolamiento, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_enrollment_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_router_config_change_region" model="ir.rule">
            <field name="name">MIRABILENET: cambios de configuración de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_router_config_change"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_router_config_change_global" model="ir.rule">
            <field name="name">MIRABILENET: cambios de configuración, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_router_config_change"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_service_region" model="ir.rule">
            <field name="name">MIRABILENET: servicios de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_service"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_service_global" model="ir.rule">
            <field name="name">MIRABILENET: servicios, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_service"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_pppoe_account_region" model="ir.rule">
            <field name="name">MIRABILENET: cuentas PPPoE de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_pppoe_account"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_pppoe_account_global" model="ir.rule">
            <field name="name">MIRABILENET: cuentas PPPoE, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_pppoe_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_service_transition_region" model="ir.rule">
            <field name="name">MIRABILENET: órdenes de red de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_service_transition"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_service_transition_global" model="ir.rule">
            <field name="name">MIRABILENET: órdenes de red, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_service_transition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
    </data>
</odoo>
