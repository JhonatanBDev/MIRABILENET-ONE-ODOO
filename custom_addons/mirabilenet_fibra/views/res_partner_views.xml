<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La ubicación del cliente en el mapa son partner_latitude/partner_longitude
         (base_geolocalize): no se duplican. -->
    <record id="view_partner_form_fiber" model="ir.ui.view">
        <field name="name">res.partner.form.fibra</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mirabilenet_fiber_ports" type="object"
                        class="oe_stat_button" icon="fa-plug"
                        invisible="not mirabilenet_fiber_port_count"
                        groups="mirabilenet_fibra.group_mirabilenet_fiber_user">
                    <field name="mirabilenet_fiber_port_count" widget="statinfo" string="NAP/Puerto"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_mirabilenet_customer_form_fiber" model="ir.ui.view">
        <field name="name">res.partner.mirabilenet.customer.form.fibra</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="mirabilenet_isp.view_mirabilenet_customer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box"
                     groups="mirabilenet_fibra.group_mirabilenet_fiber_user">
                    <button name="action_view_mirabilenet_fiber_ports" type="object"
                            class="oe_stat_button" icon="fa-plug">
                        <field name="mirabilenet_fiber_port_count" widget="statinfo"
                               string="NAP/Puerto"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_longitude']" position="after">
                <field name="mirabilenet_fiber_summary"
                       invisible="not mirabilenet_fiber_summary"
                       groups="mirabilenet_fibra.group_mirabilenet_fiber_user"/>
            </xpath>
        </field>
    </record>
</odoo>
