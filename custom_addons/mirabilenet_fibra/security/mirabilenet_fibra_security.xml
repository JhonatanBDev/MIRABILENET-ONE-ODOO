<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_mirabilenet_fiber_user" model="res.groups">
            <field name="name">MIRABILENET / Fibra: usuario</field>
            <field name="comment">Ve la red de fibra de su región y asigna o libera puertos.</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="group_mirabilenet_fiber_manager" model="res.groups">
            <field name="name">MIRABILENET / Fibra: gestor</field>
            <field name="comment">Crea y modifica NAP y tramos, importa CSV y KML y mueve los marcadores del mapa.</field>
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_fiber_user'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_superadmin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_fiber_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_admin_regional" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_fiber_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_noc" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_fiber_user'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_tecnico" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_fiber_user'))]"/>
        </record>
    </data>

    <!-- Aislamiento por región y por compañía. Las NAP y los tramos siempre tienen
         región; los puertos y las paradas la toman de su NAP o tramo. -->
    <data noupdate="1">
        <record id="rule_mirabilenet_fiber_nap_none" model="ir.rule">
            <field name="name">MIRABILENET: NAP sin región</field>
            <field name="model_id" ref="model_mirabilenet_fiber_nap"/>
            <field name="domain_force">[('region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_nap_region" model="ir.rule">
            <field name="name">MIRABILENET: NAP de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_fiber_nap"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_nap_global" model="ir.rule">
            <field name="name">MIRABILENET: NAP, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_fiber_nap"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_nap_company" model="ir.rule">
            <field name="name">MIRABILENET: NAP, multicompañía</field>
            <field name="model_id" ref="model_mirabilenet_fiber_nap"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_mirabilenet_fiber_port_none" model="ir.rule">
            <field name="name">MIRABILENET: puertos sin región</field>
            <field name="model_id" ref="model_mirabilenet_fiber_port"/>
            <field name="domain_force">[('region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_port_region" model="ir.rule">
            <field name="name">MIRABILENET: puertos de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_fiber_port"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_port_global" model="ir.rule">
            <field name="name">MIRABILENET: puertos, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_fiber_port"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_port_company" model="ir.rule">
            <field name="name">MIRABILENET: puertos, multicompañía</field>
            <field name="model_id" ref="model_mirabilenet_fiber_port"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_mirabilenet_fiber_segment_none" model="ir.rule">
            <field name="name">MIRABILENET: tramos sin región</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment"/>
            <field name="domain_force">[('region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_segment_region" model="ir.rule">
            <field name="name">MIRABILENET: tramos de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_segment_global" model="ir.rule">
            <field name="name">MIRABILENET: tramos, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_segment_company" model="ir.rule">
            <field name="name">MIRABILENET: tramos, multicompañía</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_mirabilenet_fiber_segment_stop_none" model="ir.rule">
            <field name="name">MIRABILENET: NAP en ruta sin región</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment_stop"/>
            <field name="domain_force">[('region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_segment_stop_region" model="ir.rule">
            <field name="name">MIRABILENET: NAP en ruta de la región del usuario</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment_stop"/>
            <field name="domain_force">[('region_id', '!=', False), ('region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_segment_stop_global" model="ir.rule">
            <field name="name">MIRABILENET: NAP en ruta, alcance global</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment_stop"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_mirabilenet_fiber_segment_stop_company" model="ir.rule">
            <field name="name">MIRABILENET: NAP en ruta, multicompañía</field>
            <field name="model_id" ref="model_mirabilenet_fiber_segment_stop"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
