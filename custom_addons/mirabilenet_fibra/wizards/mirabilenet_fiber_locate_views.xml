<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mirabilenet_fiber_locate_form" model="ir.ui.view">
        <field name="name">mirabilenet.fiber.locate.form</field>
        <field name="model">mirabilenet.fiber.locate</field>
        <field name="arch" type="xml">
            <form string="Ubicar cliente">
                <field name="searched" invisible="1"/>
                <group>
                    <field name="query" placeholder="Ej.: 192.168.99.8, 0005@siete, Juan Pérez"/>
                </group>
                <field name="result" nolabel="1" invisible="not searched"/>
                <field name="service_id" invisible="1"/>
                <field name="nap_id" invisible="1"/>
                <field name="port_id" invisible="1"/>
                <footer>
                    <button name="action_search" type="object" string="Buscar"
                            class="btn-primary"/>
                    <button name="action_open_map" type="object" string="Ver en el mapa"
                            invisible="not nap_id"/>
                    <button name="action_open_nap" type="object" string="Abrir caja NAP"
                            invisible="not nap_id"/>
                    <button name="action_new_failure" type="object" string="Registrar avería"
                            invisible="not service_id"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_fiber_locate" model="ir.actions.act_window">
        <field name="name">Ubicar cliente</field>
        <field name="res_model">mirabilenet.fiber.locate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
