<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mirabilenet_fiber_kml_import_form" model="ir.ui.view">
        <field name="name">mirabilenet.fiber.kml.import.form</field>
        <field name="model">mirabilenet.fiber.kml.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <group invisible="state != 'upload'">
                    <field name="region_id" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div invisible="state != 'match'">
                    <p class="text-muted">
                        Marque «Aplicar» en las filas a usar. Las coincidencias dudosas quedan sin
                        marcar: revise el tramo o la NAP antes de aplicarlas. Al aplicar un
                        recorrido se recalculan longitud y vértices; si difieren más de un 10 % de
                        lo cargado se avisa.
                    </p>
                    <field name="line_ids">
                        <list editable="bottom" create="0"
                              decoration-warning="match_quality == 'probable'"
                              decoration-muted="match_quality == 'ninguna'">
                            <field name="confirm" widget="boolean_toggle"/>
                            <field name="kind"/>
                            <field name="kml_name"/>
                            <field name="region_id" column_invisible="1"/>
                            <field name="segment_id" invisible="kind != 'line'"
                                   options="{'no_create': True}"/>
                            <field name="nap_id" invisible="kind != 'point'"
                                   options="{'no_create': True}"/>
                            <field name="match_quality"/>
                            <field name="match_note"/>
                            <field name="kml_color" widget="color"/>
                            <field name="vertex_count"/>
                            <field name="kml_length_m"/>
                            <field name="current_length_m"/>
                            <field name="length_differs"/>
                        </list>
                    </field>
                </div>
                <field name="log" invisible="state != 'done'" nolabel="1"/>
                <footer>
                    <button name="action_parse" type="object" string="Leer archivo"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_apply" type="object" string="Aplicar lo marcado"
                            class="btn-primary" invisible="state != 'match'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_fiber_kml_import" model="ir.actions.act_window">
        <field name="name">Importar KML/KMZ</field>
        <field name="res_model">mirabilenet.fiber.kml.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
