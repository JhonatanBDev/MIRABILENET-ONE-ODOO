<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mirabilenet_fiber_port_assign_form" model="ir.ui.view">
        <field name="name">mirabilenet.fiber.port.assign.form</field>
        <field name="model">mirabilenet.fiber.port.assign</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="nap_id" options="{'no_create': True}"/>
                    <field name="region_id" invisible="1"/>
                    <field name="port_id" options="{'no_create': True}"/>
                    <field name="service_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Asignar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
