<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mirabilenet_fiber_csv_import_form" model="ir.ui.view">
        <field name="name">mirabilenet.fiber.csv.import.form</field>
        <field name="model">mirabilenet.fiber.csv.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p class="text-muted">
                        CSV separados por «;», UTF-8 (con o sin BOM). Se actualiza por código: importar
                        dos veces no duplica. Un dato vacío no borra lo ya cargado. Las coordenadas
                        con puntos de miles se corrigen; las que quedan fuera de la zona se importan
                        vacías y se informan. Suba los dos archivos juntos: las correcciones cruzan
                        las NAP con los tramos.
                    </p>
                    <group>
                        <group>
                            <field name="region_id" options="{'no_create': True}"/>
                            <field name="nap_file" filename="nap_filename"/>
                            <field name="nap_filename" invisible="1"/>
                            <field name="segment_file" filename="segment_filename"/>
                            <field name="segment_filename" invisible="1"/>
                            <field name="apply_deductions"/>
                            <field name="keep_existing"/>
                        </group>
                        <group string="Zona válida de coordenadas">
                            <field name="lat_min"/>
                            <field name="lat_max"/>
                            <field name="lon_min"/>
                            <field name="lon_max"/>
                        </group>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <div class="alert alert-warning" role="alert"
                         invisible="not error_count and not rejected_count and not flagged_count">
                        Hay filas con error, coordenadas rechazadas o registros para revisar en
                        campo. El detalle está en el registro.
                    </div>
                    <group>
                        <group string="NAP">
                            <field name="nap_created"/>
                            <field name="nap_updated"/>
                        </group>
                        <group string="Tramos">
                            <field name="segment_created"/>
                            <field name="segment_updated"/>
                        </group>
                        <group string="Calidad de datos">
                            <field name="deduced_count"/>
                            <field name="flagged_count"/>
                            <field name="rejected_count"/>
                            <field name="warning_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="log" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Importar"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_fiber_csv_import" model="ir.actions.act_window">
        <field name="name">Importar CSV de NAP y tramos</field>
        <field name="res_model">mirabilenet.fiber.csv.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
