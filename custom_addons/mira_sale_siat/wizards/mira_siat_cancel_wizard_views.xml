<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mira_siat_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">mira.siat.cancel.wizard.form</field>
        <field name="model">mira.siat.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular ante el SIN">
                <group>
                    <field name="invoice_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="reason_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Anular"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
