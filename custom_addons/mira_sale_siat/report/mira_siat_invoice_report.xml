<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mira_siat_invoice" model="ir.actions.report">
        <field name="name">Factura SIAT</field>
        <field name="model">mira.siat.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mira_sale_siat.report_mira_siat_invoice</field>
        <field name="report_file">mira_sale_siat.report_mira_siat_invoice</field>
        <field name="print_report_name">'%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_mira_siat_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <record id="paperformat_mira_siat_ticket" model="report.paperformat">
        <field name="name">Mira_Sale SIAT: ticket 80 mm</field>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <field name="page_height">297</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_mira_siat_ticket" model="ir.actions.report">
        <field name="name">Ticket SIAT (80 mm)</field>
        <field name="model">mira.siat.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mira_sale_siat.report_mira_siat_ticket</field>
        <field name="report_file">mira_sale_siat.report_mira_siat_ticket</field>
        <field name="print_report_name">'Ticket-%s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_mira_siat_ticket"/>
        <field name="binding_model_id" ref="model_mira_siat_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Leyendas comunes a la hoja y al ticket. -->
    <template id="report_mira_siat_legends">
        <p class="text-center">ESTA FACTURA CONTRIBUYE AL DESARROLLO DEL PAÍS, EL USO ILÍCITO SERÁ SANCIONADO PENALMENTE DE ACUERDO A LEY</p>
        <p class="text-center" t-out="p.get('legend')"/>
        <p class="text-center">"<span t-out="doc.online_legend"/>"</p>
        <p t-if="doc.company_id.mira_siat_gateway_mode == 'fake'" class="text-center text-danger">
            <strong>DOCUMENTO DE SIMULACIÓN - SIN VALIDEZ FISCAL</strong>
        </p>
    </template>

    <!-- La representación gráfica se arma SOLO con los datos fiscales emitidos
         (payload), para que coincida exactamente con el XML enviado al SIN. -->
    <template id="report_mira_siat_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="p" t-value="doc.payload or {}"/>
                <t t-set="is_note" t-value="doc.document_kind == 'note'"/>
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size: 12px;">
                        <div class="row">
                            <div class="col-6">
                                <strong t-out="p.get('issuer_name')"/><br/>
                                <span t-out="doc.branch_id.name"/><br/>
                                <span>N.º punto de venta: </span><span t-out="p.get('pos_code')"/><br/>
                                <span t-out="p.get('address')"/><br/>
                                <t t-if="p.get('phone')">
                                    <span>Teléfono: </span><span t-out="p.get('phone')"/><br/>
                                </t>
                                <span t-out="p.get('municipality')"/>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr><td><strong>NIT</strong></td><td t-out="p.get('issuer_nit')"/></tr>
                                    <tr>
                                        <td><strong t-out="'NOTA N.º' if is_note else 'FACTURA N.º'"/></td>
                                        <td t-out="p.get('number')"/>
                                    </tr>
                                    <tr><td><strong>CÓD. AUTORIZACIÓN</strong></td>
                                        <td style="word-break: break-all;" t-out="p.get('cuf')"/></tr>
                                </table>
                            </div>
                        </div>
                        <h4 class="text-center mt-3" t-out="'NOTA DE CRÉDITO-DÉBITO' if is_note else 'FACTURA'"/>
                        <p class="text-center" t-if="not is_note">(Con Derecho a Crédito Fiscal)</p>
                        <p t-if="doc.state == 'cancelled'" class="text-center text-danger">
                            <strong>DOCUMENTO ANULADO</strong>
                        </p>
                        <div class="row">
                            <div class="col-7">
                                <strong>Fecha: </strong><span t-out="(p.get('emission_iso') or '').replace('T', ' ')[:19]"/><br/>
                                <strong>Nombre/Razón Social: </strong><span t-out="p.get('customer_name')"/>
                            </div>
                            <div class="col-5">
                                <strong>NIT/CI/CEX: </strong><span t-out="p.get('customer_doc_number')"/>
                                <t t-if="p.get('customer_complement')">-<span t-out="p.get('customer_complement')"/></t><br/>
                                <strong>Cód. Cliente: </strong><span t-out="p.get('customer_code')"/>
                            </div>
                        </div>
                        <div class="row mt-2" t-if="is_note">
                            <div class="col-12">
                                <strong>Factura original N.º: </strong><span t-out="p.get('original_number')"/>
                                &#160;&#160;<strong>Fecha: </strong><span t-out="(p.get('original_emission_iso') or '').replace('T', ' ')[:19]"/><br/>
                                <strong>Cód. autorización original: </strong>
                                <span style="word-break: break-all;" t-out="p.get('original_cuf')"/>
                            </div>
                        </div>
                        <t t-foreach="[1, 2] if is_note else [0]" t-as="group">
                            <h6 class="mt-3" t-if="group == 1">DATOS DE LA FACTURA ORIGINAL</h6>
                            <h6 class="mt-3" t-if="group == 2">DETALLE DE LA DEVOLUCIÓN O RESCISIÓN</h6>
                            <table class="table table-sm mt-2">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Cantidad</th>
                                        <th>Unidad</th>
                                        <th>Descripción</th>
                                        <th class="text-end">Precio unitario</th>
                                        <th class="text-end">Descuento</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="p.get('lines', [])" t-as="line">
                                        <tr t-if="not group or line.get('transaction_code') == group">
                                            <td t-out="line.get('product_code')"/>
                                            <td t-out="line.get('quantity')"/>
                                            <td t-out="line.get('unit_code')"/>
                                            <td t-out="line.get('description')"/>
                                            <td class="text-end" t-out="line.get('unit_price')"/>
                                            <td class="text-end" t-out="line.get('discount')"/>
                                            <td class="text-end" t-out="line.get('subtotal')"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <div class="row">
                            <div class="col-7">
                                <strong>Son: </strong><span t-out="doc.amount_in_words()"/>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm table-borderless" t-if="not is_note">
                                    <tr t-if="p.get('additional_discount')"><td>DESCUENTO Bs</td><td class="text-end" t-out="p.get('additional_discount')"/></tr>
                                    <tr><td>TOTAL Bs</td><td class="text-end" t-out="p.get('amount_total')"/></tr>
                                    <tr><td>MONTO GIFT CARD Bs</td><td class="text-end" t-out="p.get('gift_card_amount') or '0.00'"/></tr>
                                    <tr><td><strong>MONTO A PAGAR Bs</strong></td><td class="text-end"><strong t-out="p.get('amount_subject_to_vat')"/></td></tr>
                                    <tr><td>IMPORTE BASE CRÉDITO FISCAL Bs</td><td class="text-end" t-out="p.get('amount_subject_to_vat')"/></tr>
                                    <tr t-if="p.get('exchange_rate') not in (None, '1.00')">
                                        <td>Tipo de cambio / total en moneda</td>
                                        <td class="text-end"><span t-out="p.get('exchange_rate')"/> / <span t-out="p.get('amount_total_currency')"/></td>
                                    </tr>
                                </table>
                                <table class="table table-sm table-borderless" t-if="is_note">
                                    <tr><td>MONTO TOTAL ORIGINAL Bs</td><td class="text-end" t-out="p.get('amount_original')"/></tr>
                                    <tr><td><strong>MONTO TOTAL DEVUELTO Bs</strong></td><td class="text-end"><strong t-out="p.get('amount_returned')"/></td></tr>
                                    <tr><td>MONTO EFECTIVO DEL CRÉDITO O DÉBITO (13 %) Bs</td><td class="text-end" t-out="p.get('amount_effective')"/></tr>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-9" style="font-size: 10px;">
                                <t t-call="mira_sale_siat.report_mira_siat_legends"/>
                            </div>
                            <div class="col-3 text-end">
                                <img t-if="doc.qr_src" t-att-src="doc.qr_src"
                                     style="width: 120px; height: 120px;" alt="QR"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Ticket para impresora térmica de 80 mm. -->
    <template id="report_mira_siat_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="p" t-value="doc.payload or {}"/>
                <t t-set="is_note" t-value="doc.document_kind == 'note'"/>
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size: 10px; width: 72mm;">
                        <div class="text-center">
                            <strong t-out="'NOTA DE CRÉDITO-DÉBITO' if is_note else 'FACTURA'"/><br/>
                            <span t-if="not is_note">CON DERECHO A CRÉDITO FISCAL<br/></span>
                            <strong t-out="p.get('issuer_name')"/><br/>
                            <span t-out="doc.branch_id.name"/><br/>
                            N.º Punto de Venta <span t-out="p.get('pos_code')"/><br/>
                            <span t-out="p.get('address')"/><br/>
                            <t t-if="p.get('phone')">Tel. <span t-out="p.get('phone')"/><br/></t>
                            <span t-out="p.get('municipality')"/>
                        </div>
                        <hr/>
                        <div class="text-center">
                            <strong>NIT</strong> <span t-out="p.get('issuer_nit')"/><br/>
                            <strong t-out="'NOTA N.º' if is_note else 'FACTURA N.º'"/> <span t-out="p.get('number')"/><br/>
                            <strong>CÓD. AUTORIZACIÓN</strong><br/>
                            <span style="word-break: break-all;" t-out="p.get('cuf')"/>
                        </div>
                        <p t-if="doc.state == 'cancelled'" class="text-center"><strong>DOCUMENTO ANULADO</strong></p>
                        <hr/>
                        <strong>NOMBRE/RAZÓN SOCIAL:</strong> <span t-out="p.get('customer_name')"/><br/>
                        <strong>NIT/CI/CEX:</strong> <span t-out="p.get('customer_doc_number')"/>
                        <t t-if="p.get('customer_complement')">-<span t-out="p.get('customer_complement')"/></t><br/>
                        <strong>CÓD. CLIENTE:</strong> <span t-out="p.get('customer_code')"/><br/>
                        <strong>FECHA DE EMISIÓN:</strong> <span t-out="(p.get('emission_iso') or '').replace('T', ' ')[:19]"/>
                        <t t-if="is_note"><br/><strong>FACTURA ORIGINAL N.º:</strong> <span t-out="p.get('original_number')"/></t>
                        <hr/>
                        <t t-foreach="p.get('lines', [])" t-as="line">
                            <div t-if="not is_note or line.get('transaction_code') == 2">
                                <span t-out="line.get('product_code')"/> - <span t-out="line.get('description')"/><br/>
                                <span t-out="line.get('quantity')"/> x <span t-out="line.get('unit_price')"/>
                                - <span t-out="line.get('discount')"/>
                                <span style="float: right;" t-out="line.get('subtotal')"/>
                            </div>
                        </t>
                        <hr/>
                        <t t-if="not is_note">
                            <div t-if="p.get('additional_discount')">DESCUENTO Bs <span style="float: right;" t-out="p.get('additional_discount')"/></div>
                            <div>TOTAL Bs <span style="float: right;" t-out="p.get('amount_total')"/></div>
                            <div>MONTO GIFT CARD Bs <span style="float: right;" t-out="p.get('gift_card_amount') or '0.00'"/></div>
                            <div><strong>MONTO A PAGAR Bs <span style="float: right;" t-out="p.get('amount_subject_to_vat')"/></strong></div>
                            <div>IMPORTE BASE CRÉDITO FISCAL Bs <span style="float: right;" t-out="p.get('amount_subject_to_vat')"/></div>
                        </t>
                        <t t-if="is_note">
                            <div>MONTO TOTAL ORIGINAL Bs <span style="float: right;" t-out="p.get('amount_original')"/></div>
                            <div><strong>MONTO TOTAL DEVUELTO Bs <span style="float: right;" t-out="p.get('amount_returned')"/></strong></div>
                            <div>MONTO EFECTIVO CRÉDITO/DÉBITO Bs <span style="float: right;" t-out="p.get('amount_effective')"/></div>
                        </t>
                        <p class="mt-2">Son: <span t-out="doc.amount_in_words()"/></p>
                        <hr/>
                        <div style="font-size: 8px;">
                            <t t-call="mira_sale_siat.report_mira_siat_legends"/>
                        </div>
                        <div class="text-center">
                            <img t-if="doc.qr_src" t-att-src="doc.qr_src"
                                 style="width: 35mm; height: 35mm;" alt="QR"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
