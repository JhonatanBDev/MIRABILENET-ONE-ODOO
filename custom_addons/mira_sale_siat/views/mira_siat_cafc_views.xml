<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Talonarios CAFC ================= -->
    <record id="mira_siat_cafc_view_list" model="ir.ui.view">
        <field name="name">mira.siat.cafc.list</field>
        <field name="model">mira.siat.cafc</field>
        <field name="arch" type="xml">
            <list decoration-danger="available_count == 0"
                  decoration-warning="available_count &gt; 0 and available_count &lt; 50">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="pos_id"/>
                <field name="number_from"/>
                <field name="number_to"/>
                <field name="used_count"/>
                <field name="available_count"/>
                <field name="date_due"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_cafc_view_form" model="ir.ui.view">
        <field name="name">mira.siat.cafc.form</field>
        <field name="model">mira.siat.cafc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pos_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_due"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="number_from"/>
                            <field name="number_to"/>
                            <field name="used_count"/>
                            <field name="available_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Facturas transcritas" name="invoices">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="partner_id"/>
                                    <field name="emission_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mira_siat_cafc_action" model="ir.actions.act_window">
        <field name="name">Talonarios CAFC</field>
        <field name="res_model">mira.siat.cafc</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin talonarios CAFC</p>
            <p>El CAFC es el código que el SIN autoriza para facturas manuales (en
               papel) durante contingencias como corte de energía o falla de equipos.
               Registre aquí el talonario; luego cree un evento de regularización con
               ese talonario y transcriba cada factura desde su venta.</p>
        </field>
    </record>
</odoo>
