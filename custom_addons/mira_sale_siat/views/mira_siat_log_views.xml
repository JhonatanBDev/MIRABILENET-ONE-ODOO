<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Evidencia y auditoría ================= -->
    <record id="mira_siat_log_view_list" model="ir.ui.view">
        <field name="name">mira.siat.log.list</field>
        <field name="model">mira.siat.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="not success">
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="service"/>
                <field name="operation"/>
                <field name="duration_ms"/>
                <field name="success"/>
                <field name="error_code"/>
                <field name="correlation_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_log_view_form" model="ir.ui.view">
        <field name="name">mira.siat.log.form</field>
        <field name="model">mira.siat.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="service"/>
                            <field name="operation"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="success"/>
                            <field name="error_code"/>
                            <field name="duration_ms"/>
                            <field name="correlation_id"/>
                        </group>
                    </group>
                    <separator string="Solicitud"/>
                    <field name="request_xml"/>
                    <separator string="Respuesta"/>
                    <field name="response_xml"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mira_siat_log_action" model="ir.actions.act_window">
        <field name="name">Evidencia técnica</field>
        <field name="res_model">mira.siat.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
