<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Puntos de venta ================= -->
    <record id="mira_siat_pos_view_list" model="ir.ui.view">
        <field name="name">mira.siat.pos.list</field>
        <field name="model">mira.siat.pos</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="branch_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="pending_registration" optional="show"/>
                <field name="cuis_valid_until"/>
                <field name="cufd_valid_until"/>
                <field name="connectivity_state" widget="badge"
                       decoration-success="connectivity_state == 'online'"
                       decoration-warning="connectivity_state == 'degraded'"
                       decoration-danger="connectivity_state == 'contingency'"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_pos_view_form" model="ir.ui.view">
        <field name="name">mira.siat.pos.form</field>
        <field name="model">mira.siat.pos</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_register" type="object" class="oe_highlight"
                            string="Registrar ante el SIN" invisible="code &gt;= 0"
                            confirm="Se registrará un punto de venta nuevo ante el SIN. ¿Continuar?"
                            groups="mira_sale_siat.group_mira_siat_manager"/>
                    <button name="action_refresh_cuis" type="object" string="Renovar CUIS"
                            invisible="code &lt; 0"
                            groups="mira_sale_siat.group_mira_siat_manager"/>
                    <button name="action_refresh_cufd" type="object" string="Renovar CUFD"
                            class="oe_highlight"
                            groups="mira_sale_siat.group_mira_siat_manager"/>
                    <button name="action_sync_catalogs" type="object"
                            string="Sincronizar catálogos"
                            groups="mira_sale_siat.group_mira_siat_manager"/>
                    <button name="action_check_health" type="object"
                            string="Probar comunicación" invisible="code &lt; 0"/>
                    <button name="action_close_pos" type="object" string="Cerrar ante el SIN"
                            invisible="code &lt;= 0"
                            confirm="El punto de venta se cerrará ante el SIN y se archivará. ¿Continuar?"
                            groups="mira_sale_siat.group_mira_siat_manager"/>
                    <field name="connectivity_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="code &gt;= 0">
                        Punto de venta con código provisional: todavía no existe en el
                        SIN y no puede emitir. Indique su tipo y use «Registrar ante el
                        SIN». Si el punto ya existe en el SIN, escriba aquí su código real.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Caja 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="code"/>
                            <field name="pos_type_id" options="{'no_create': True}"/>
                            <field name="is_default"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Salud">
                            <field name="cuis_valid_until"/>
                            <field name="cufd_valid_until"/>
                            <field name="last_error_at"/>
                        </group>
                    </group>
                    <notebook groups="mira_sale_siat.group_mira_siat_manager">
                        <page string="CUFD" name="cufd">
                            <field name="cufd_ids" readonly="1" context="{'active_test': False}">
                                <list>
                                    <field name="valid_from"/>
                                    <field name="valid_until"/>
                                    <field name="address"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="CUIS" name="cuis">
                            <field name="cuis_ids" readonly="1" context="{'active_test': False}">
                                <list>
                                    <field name="valid_until"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mira_siat_pos_action" model="ir.actions.act_window">
        <field name="name">Puntos de venta</field>
        <field name="res_model">mira.siat.pos</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
