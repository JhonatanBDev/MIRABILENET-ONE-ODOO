<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mira_siat_audit_log_view_list" model="ir.ui.view">
        <field name="name">mira.siat.audit.log.list</field>
        <field name="model">mira.siat.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="ip"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_audit_log_view_form" model="ir.ui.view">
        <field name="name">mira.siat.audit.log.form</field>
        <field name="model">mira.siat.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="ip"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="correlation_id"/>
                        </group>
                    </group>
                    <field name="changes_text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mira_siat_audit_log_action" model="ir.actions.act_window">
        <field name="name">Auditoría</field>
        <field name="res_model">mira.siat.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
