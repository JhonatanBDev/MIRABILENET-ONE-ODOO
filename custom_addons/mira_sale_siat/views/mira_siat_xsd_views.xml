<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= XSD ================= -->
    <record id="mira_siat_xsd_view_list" model="ir.ui.view">
        <field name="name">mira.siat.xsd.list</field>
        <field name="model">mira.siat.xsd</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sector_code"/>
                <field name="modality"/>
                <field name="version_note"/>
                <field name="sha256"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_xsd_view_form" model="ir.ui.view">
        <field name="name">mira.siat.xsd.form</field>
        <field name="model">mira.siat.xsd</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sector_code"/>
                            <field name="modality"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="version_note"/>
                            <field name="sha256"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Para actualizar un esquema, archive el anterior y cargue el nuevo:
                        cada factura conserva la huella del XSD con el que se validó.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mira_siat_xsd_action" model="ir.actions.act_window">
        <field name="name">Esquemas XSD</field>
        <field name="res_model">mira.siat.xsd</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
