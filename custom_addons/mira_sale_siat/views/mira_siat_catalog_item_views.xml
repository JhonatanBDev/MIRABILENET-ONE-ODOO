<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Métodos de pago y monedas ================= -->
    <record id="mira_siat_payment_method_view_list" model="ir.ui.view">
        <field name="name">mira.siat.catalog.item.payment.list</field>
        <field name="model">mira.siat.catalog.item</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="code"/>
                <field name="name"/>
                <field name="components"/>
                <field name="includes_card"/>
                <field name="includes_gift_card"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_payment_method_action" model="ir.actions.act_window">
        <field name="name">Métodos de pago SIN</field>
        <field name="res_model">mira.siat.catalog.item</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mira_siat_payment_method_view_list"/>
        <field name="domain">[('catalog_type', '=', 'tipo_metodo_pago')]</field>
    </record>

    <record id="mira_siat_currency_view_list" model="ir.ui.view">
        <field name="name">mira.siat.catalog.item.currency.list</field>
        <field name="model">mira.siat.catalog.item</field>
        <field name="priority">31</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom">
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="currency_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="mira_siat_currency_action" model="ir.actions.act_window">
        <field name="name">Monedas SIN</field>
        <field name="res_model">mira.siat.catalog.item</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mira_siat_currency_view_list"/>
        <field name="domain">[('catalog_type', '=', 'tipo_moneda')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin monedas sincronizadas</p>
            <p>Vincule cada código de moneda del SIN con la moneda de Odoo que usa
               al facturar.</p>
        </field>
    </record>
</odoo>
