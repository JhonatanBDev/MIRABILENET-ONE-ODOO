<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Quién factura y cobra: usa el grupo de facturación de Odoo, no uno propio. -->
        <record id="mirabilenet_base.group_role_superadmin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_gerencia" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_admin_regional" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_finanzas" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_cajero" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_cobrador" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- Reglas sin grupo: se suman a las de Odoo en vez de competir con ellas. Lo que no
             tiene región (asientos contables generales) no se filtra. -->
        <record id="rule_account_move_region" model="ir.rule">
            <field name="name">MIRABILENET: facturas de la región del usuario</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">['|', '|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id), (1 if user.mirabilenet_is_global else 0, '=', 1)]</field>
        </record>
        <record id="rule_account_payment_region" model="ir.rule">
            <field name="name">MIRABILENET: pagos de la región del usuario</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">['|', '|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id), (1 if user.mirabilenet_is_global else 0, '=', 1)]</field>
        </record>
        <record id="rule_contract_region" model="ir.rule">
            <field name="name">MIRABILENET: contratos de la región del usuario</field>
            <field name="model_id" ref="contract.model_contract_contract"/>
            <field name="domain_force">['|', '|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id), (1 if user.mirabilenet_is_global else 0, '=', 1)]</field>
        </record>
    </data>
</odoo>
