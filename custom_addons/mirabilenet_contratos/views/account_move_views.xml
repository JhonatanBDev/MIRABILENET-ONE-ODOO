<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_mirabilenet" model="ir.ui.view">
        <field name="name">account.move.form.mirabilenet</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mirabilenet_region_id" options="{'no_create': True}"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="mirabilenet_service_id" readonly="1" invisible="not mirabilenet_service_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_tree_mirabilenet" model="ir.ui.view">
        <field name="name">account.move.list.mirabilenet</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="mirabilenet_region_id" optional="show"/>
                <field name="mirabilenet_service_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
