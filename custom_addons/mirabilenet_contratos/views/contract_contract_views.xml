<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_form_mirabilenet" model="ir.ui.view">
        <field name="name">contract.contract.form.mirabilenet</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mirabilenet_service_id" invisible="not mirabilenet_service_id"/>
                <field name="mirabilenet_region_id" invisible="not mirabilenet_service_id"/>
            </xpath>
        </field>
    </record>
</odoo>
