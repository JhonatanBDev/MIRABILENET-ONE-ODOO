<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Existencias -->
    <record id="view_mirabilenet_quant_list" model="ir.ui.view">
        <field name="name">stock.quant.mirabilenet.list</field>
        <field name="model">stock.quant</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="mirabilenet_region_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity" sum="Total"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>

    <record id="action_mirabilenet_quant" model="ir.actions.act_window">
        <field name="name">Existencias</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="context">{'group_by': ['product_id']}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mirabilenet_quant_list')})]"/>
    </record>
</odoo>
