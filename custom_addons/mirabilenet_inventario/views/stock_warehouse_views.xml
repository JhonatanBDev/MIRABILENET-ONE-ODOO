<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Almacenes -->
    <record id="view_mirabilenet_warehouse_list" model="ir.ui.view">
        <field name="name">stock.warehouse.mirabilenet.list</field>
        <field name="model">stock.warehouse</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="mirabilenet_branch_id"/>
                <field name="mirabilenet_region_id"/>
                <field name="mirabilenet_responsible_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mirabilenet_warehouse_form" model="ir.ui.view">
        <field name="name">stock.warehouse.mirabilenet.form</field>
        <field name="model">stock.warehouse</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="mirabilenet_branch_id" required="1"
                                   options="{'no_create': True}"/>
                            <field name="mirabilenet_region_id"/>
                            <field name="mirabilenet_responsible_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mirabilenet_warehouse" model="ir.actions.act_window">
        <field name="name">Almacenes</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mirabilenet_warehouse_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mirabilenet_warehouse_form')})]"/>
    </record>
</odoo>
