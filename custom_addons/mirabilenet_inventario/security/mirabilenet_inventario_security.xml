<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_mirabilenet_stock_user" model="res.groups">
            <field name="name">MIRABILENET / Registra movimientos de inventario</field>
            <field name="implied_ids" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="group_mirabilenet_stock_manager" model="res.groups">
            <field name="name">MIRABILENET / Administra almacenes y artículos</field>
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_stock_user')), (4, ref('stock.group_stock_manager')), (4, ref('stock.group_production_lot'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_superadmin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_stock_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_admin_regional" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_stock_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_almacenista" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_stock_manager'))]"/>
        </record>
        <record id="mirabilenet_base.group_role_tecnico" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mirabilenet_stock_user'))]"/>
        </record>
    </data>

    <!-- Aislamiento por región. Lo que no tiene región (el almacén genérico de Odoo)
         lo ve cualquiera. -->
    <data noupdate="1">
        <record id="rule_stock_warehouse_none" model="ir.rule">
            <field name="name">MIRABILENET: almacenes sin región</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="domain_force">[('mirabilenet_region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_stock_warehouse_region" model="ir.rule">
            <field name="name">MIRABILENET: almacenes de la región del usuario</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="domain_force">['|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_stock_warehouse_global" model="ir.rule">
            <field name="name">MIRABILENET: almacenes, alcance global</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_stock_location_none" model="ir.rule">
            <field name="name">MIRABILENET: ubicaciones sin región</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">['|', ('warehouse_id', '=', False), ('warehouse_id.mirabilenet_region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_stock_location_region" model="ir.rule">
            <field name="name">MIRABILENET: ubicaciones de la región del usuario</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">['|', ('warehouse_id', '=', False), '|', ('warehouse_id.mirabilenet_region_id', '=', False), ('warehouse_id.mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_stock_location_global" model="ir.rule">
            <field name="name">MIRABILENET: ubicaciones, alcance global</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_stock_quant_none" model="ir.rule">
            <field name="name">MIRABILENET: existencias sin región</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">[('mirabilenet_region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
