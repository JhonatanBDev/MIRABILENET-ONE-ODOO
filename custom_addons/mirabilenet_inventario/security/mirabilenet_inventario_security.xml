            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_stock_move_line_global" model="ir.rule">
            <field name="name">MIRABILENET: líneas de movimiento, alcance global</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
    </data>
</odoo>
