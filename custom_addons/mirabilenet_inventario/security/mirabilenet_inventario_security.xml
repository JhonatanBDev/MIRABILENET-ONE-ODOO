            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">['|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_stock_quant_global" model="ir.rule">
            <field name="name">MIRABILENET: existencias, alcance global</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_stock_lot_none" model="ir.rule">
            <field name="name">MIRABILENET: series sin región</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="domain_force">[('mirabilenet_region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_stock_lot_region" model="ir.rule">
            <field name="name">MIRABILENET: series de la región del usuario</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="domain_force">['|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_stock_lot_global" model="ir.rule">
            <field name="name">MIRABILENET: series, alcance global</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_stock_move_none" model="ir.rule">
            <field name="name">MIRABILENET: movimientos sin región</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">[('mirabilenet_region_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_stock_move_region" model="ir.rule">
            <field name="name">MIRABILENET: movimientos de la región del usuario</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">['|', ('mirabilenet_region_id', '=', False), ('mirabilenet_region_id', '=', user.mirabilenet_region_id.id)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_user'))]"/>
        </record>
        <record id="rule_stock_move_global" model="ir.rule">
            <field name="name">MIRABILENET: movimientos, alcance global</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mirabilenet_base.group_mirabilenet_global'))]"/>
        </record>
        <record id="rule_stock_move_line_none" model="ir.rule">
            <field name="name">MIRABILENET: líneas de movimiento sin región</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
