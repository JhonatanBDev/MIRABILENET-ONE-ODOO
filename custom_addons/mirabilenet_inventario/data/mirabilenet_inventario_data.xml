<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Ubicaciones virtuales: de aquí sale o aquí termina lo que no está en un almacén. -->
    <record id="location_baja" model="stock.location">
        <field name="name">MIRABILENET: Baja de equipos</field>
        <field name="usage">inventory</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="location_consumo" model="stock.location">
        <field name="name">MIRABILENET: Consumo de material</field>
        <field name="usage">inventory</field>
        <field name="company_id" eval="False"/>
    </record>
