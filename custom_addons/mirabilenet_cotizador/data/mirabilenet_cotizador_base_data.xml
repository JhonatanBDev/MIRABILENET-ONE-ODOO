<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_mirabilenet_cot_quote" model="ir.sequence">
        <field name="name">Cotizaciones del cotizador</field>
        <field name="code">mirabilenet.cot.quote</field>
        <field name="prefix">COT-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Para las líneas que no son un producto del catálogo (materiales con precio de
         referencia, mano de obra, viáticos). Sin impuestos: el cotizador los suma aparte. -->
    <record id="product_cot_material" model="product.product">
        <field name="name">Material de instalación</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
        <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
    </record>
    <record id="product_cot_labor" model="product.product">
        <field name="name">Mano de obra de instalación</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
        <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
    </record>
    <record id="product_cot_travel" model="product.product">
        <field name="name">Movilidad y viáticos</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
        <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
    </record>
</odoo>
