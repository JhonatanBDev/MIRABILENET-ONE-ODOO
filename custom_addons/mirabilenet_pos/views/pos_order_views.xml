<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_mirabilenet" model="ir.ui.view">
        <field name="name">pos.order.form.mirabilenet</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Servicios solicitados" name="mirabilenet_services"
                      invisible="not mirabilenet_service_ids">
                    <field name="mirabilenet_service_ids" readonly="1">
                        <list><field name="name"/><field name="plan_id"/><field name="state"/></list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
