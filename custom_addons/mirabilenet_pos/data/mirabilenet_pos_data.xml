<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_category_plans" model="product.category">
            <field name="name">Planes de internet</field>
        </record>
        <!-- En caja el plan no se cobra: el mes lo factura el contrato del servicio. -->
        <record id="pricelist_branch" model="product.pricelist">
            <field name="name">Sucursales MIRABILENET</field>
            <field name="company_id" eval="False"/>
            <field name="item_ids" eval="[(0, 0, {
                'applied_on': '2_product_category',
                'categ_id': ref('product_category_plans'),
                'compute_price': 'fixed', 'fixed_price': 0.0})]"/>
        </record>
        <record id="product_installation" model="product.product">
            <field name="name">Instalación del servicio</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="available_in_pos" eval="True"/>
            <field name="description_sale">El monto se cotiza según la distancia y el equipo.</field>
        </record>
    </data>
</odoo>
