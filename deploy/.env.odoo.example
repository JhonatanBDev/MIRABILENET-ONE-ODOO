# Copiar a .env.odoo en el VPS (chmod 600). Este ejemplo va en Git; .env.odoo nunca.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambiar
USER=odoo
PASSWORD=cambiar
# Claves maestras de ESTE servidor (no las del equipo de desarrollo). Ver claves_maestras.md.
MIRA_SIAT_MASTER_KEY=
MIRABILENET_MASTER_KEY=
# Los mismos valores que usa hoy la API del sistema anterior con n8n.
MIRABILENET_N8N_API_TOKEN=
MIRABILENET_N8N_WEBHOOK_SECRET=
TZ=America/La_Paz
